# Salin file ini menjadi .env.local untuk pengembangan lokal:  cp .env.example .env.local
# Di Vercel, isi variabel yang sama lewat Project Settings > Environment Variables.
# Semua variabel berawalan NEXT_PUBLIC_ ikut terkirim ke browser, jadi JANGAN taruh rahasia di sini.

# Alamat publik situs, tanpa garis miring di akhir. Dipakai untuk tautan dan pratinjau saat dibagikan.
# Kalau dikosongkan di Vercel, alamat produksi proyek dipakai otomatis.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Alamat dasar REST API backend, misalnya https://api.contoh.id/api/v1
# BELUM DIPAKAI: backend belum ada, jadi aplikasi masih memakai data contoh di browser.
# Disiapkan supaya tahap backend tinggal mengisi nilainya.
NEXT_PUBLIC_API_URL=

# --- Hanya untuk server. JANGAN diberi awalan NEXT_PUBLIC_. ---

# Alamat koneksi PostgreSQL (Neon). Ambil dari dashboard Neon atau dari Vercel > Storage > database > .env.local.
# Pakai alamat "pooled" (host-nya mengandung "-pooler"). Contoh bentuknya:
# DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
